# CLS Agent 可观测应用对应的 trace 日志主题 ID（注意：不是应用 ID）
CLS_TOPIC_ID=00000000-0000-0000-0000-000000000000

# 主题所在地域，如 ap-shanghai / ap-guangzhou / ap-beijing
CLS_REGION=ap-shanghai

# 腾讯云访问密钥。强烈建议使用 CAM 子账号，只授予目标主题的写日志权限（cls:PushLog）
CLS_SECRET_ID=your-secret-id
CLS_SECRET_KEY=your-secret-key

# 可选：使用 STS 临时密钥时取消注释
# CLS_TOKEN=your-session-token

# 可选：诊断日志
# CLS_OBS_DEBUG=1
